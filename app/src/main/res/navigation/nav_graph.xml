<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/MapFragment">

    <fragment
        android:id="@+id/MapFragment"
        android:name="com.aoai.autobahn.MapFragment"
        android:label="AUTOBAHN"
        tools:layout="@layout/fragment_map">
        <action
            android:id="@+id/action_MapFragment_to_SearchFragment"
            app:destination="@id/SearchFragment" />
        <action
            android:id="@+id/action_MapFragment_to_SettingsFragment"
            app:destination="@id/SettingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/SearchFragment"
        android:name="com.aoai.autobahn.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/SettingsFragment"
        android:name="com.aoai.autobahn.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_SettingsFragment_to_LanguageSelectionFragment"
            app:destination="@id/LanguageSelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/LanguageSelectionFragment"
        android:name="com.aoai.autobahn.LanguageSelectionFragment"
        android:label="Select Language"
        tools:layout="@layout/fragment_language_selection" />

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.aoai.autobahn.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">
        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.aoai.autobahn.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">
        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
</navigation>